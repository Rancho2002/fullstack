<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Generate Dummy Data</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #dbefff;
        }

        .container {
            text-align: center;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            flex-direction: column;
            gap:20px;
        }

        textarea {
            width: 500px;
            height: 200px;
            outline: none;
            border: none;
            transition: outline 0.3s ease-in-out;
            border-radius: 5px;
            padding: 8px;
            /* add some padding */
            box-sizing: border-box;
            /* padding: 10px; */
        }

        textarea:focus {
            outline: 4px solid rgba(0, 119, 255, 0.5);
            animation: outlinePulse 2s forwards;
        }

        @keyframes outlinePulse {
            0% {
                outline-color: rgba(0, 119, 255, 0);
            }

            50% {
                outline-color: rgba(0, 119, 255, 0.5);
            }

            100% {
                outline-color: rgba(0, 119, 255, 0);
            }
        }

        .btn button {
            padding: 10px 20px;
            font-size: 16px;
            width: 200px;
            cursor: pointer;
            border: none;
            border-radius: 5px;
            color: white;
            text-shadow: black 1px 1px 2px;
        }
        #generate{
            background-color: rgb(14, 216, 14);
        }
        #generate:hover{
            background-color: rgb(0, 255, 0);
        }
        #delete{
            background-color: rgb(190, 11, 11);
        }
        #delete:hover{
            background-color: rgb(255, 6, 6);
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="input"><textarea name="" id="" readonly><%= data %></textarea></div>
            <div class="btn"><button id="generate">Generate Data</button></div>
            <div class="btn"><button id="delete">Delete Data</button></div>
        
        <script src="/script.js"></script>
</body>

</html>